    "style:all": "tsc && npm run lint && npm run format:check",
    "lint": "oxlint",
    "lint:fix": "oxlint --fix",
    "format": "oxfmt",
    "format:check": "oxfmt --check",
    "prepare": "husky ./.husky",
    "cy:open": "cypress open",
    "cy:test": "cypress run"
  },
  "dependencies": {
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.14.0",
    "@mui/icons-material": "^7.3.6",
    "@mui/material": "^7.3.6",
    "@mui/x-data-grid": "^8.22.0",
    "@mui/x-date-pickers": "^8.22.0",
    "@strudel-science/components": "^1.0.0",
    "@tanstack/react-query": "^5.90.12",
    "@tanstack/react-router": "^1.141.2",
    "axios": "^1.20.0",
    "d3-fetch": "^3.0.1",
    "dayjs": "^1.11.19",
    "plotly.js": "^2.30.1",
    "react": "^19.2.3",
    "react-dom": "^19.2.0",
    "react-plotly.js": "^2.6.0"
  },
  "devDependencies": {
    "@tanstack/router-devtools": "^1.109.2",
