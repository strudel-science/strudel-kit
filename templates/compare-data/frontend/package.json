    "@vitejs/plugin-react": "^4.2.1",
    "cypress": "^16.3.0",
    "gh-pages": "^6.1.1",
    "husky": "^9.1.6",
    "lint-staged": "^15.2.10",
    "oxfmt": "^0.79.0",
    "oxlint": "^1.94.0",
    "typescript": "^5.2.2",
    "vite": "^8.3.8"
  },
  "engines": {
    "node": "^18.18.0 || >=20.0.0"
